{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateSessionResponse",
  "description": "Response body for POST /session – returns the new session details.",
  "type": "object",
  "required": ["session_id", "status", "created_at"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique identifier for the created session.",
      "example": "sess_xyz789"
    },
    "status": {
      "type": "string",
      "enum": ["created", "ready"],
      "description": "Current status of the session.",
      "example": "created"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of session creation.",
      "example": "2026-10-04T16:00:00Z"
    }
  },
  "additionalProperties": false
}
