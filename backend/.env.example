PORT=8000
# Gemini API key (https://aistudio.google.com/apikey). Required: without it grading returns 503.
LLM_API_KEY=
# Registering as a teacher needs this code. Empty = anyone can.
TEACHER_INVITE_CODE=
# Any Gemini model that supports structured output.
LLM_MODEL=gemini-flash-lite-latest
# Tried in turn when a model is busy or out of quota.
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# Where sessions and accounts are saved. Empty = memory only.
DATA_DIR=./data
# Flutter web build to serve at / (built with API_BASE_URL=same-origin).
# PUBLIC_DIR=../app/build/web
# SEED_SAMPLES=false        # true adds made-up sample sessions
# SEED_DEMO_ACCOUNTS=false  # true adds student@/teacher@vivduck.test
# OFFLINE_GRADER=false      # true grades by keyword matching, no Gemini
# AI_RATE_PER_MINUTE=40
